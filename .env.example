# Bearer token for the HTTP API (POST /ingest, POST /search, GET /recent).
#
# Generate one and paste it below — the server refuses to start on a
# placeholder or on anything shorter than 32 characters:
#
#     openssl rand -hex 32
#
# The HTTP server listens on 127.0.0.1 only. It is reachable from your phone
# solely through a tunnel you start yourself:
#
#     cloudflared tunnel --url localhost:4322
#
OMNICONTEXT_API_KEY=

# Optional: extra Host headers the HTTP server will accept, comma-separated.
# localhost, 127.0.0.1 and *.trycloudflare.com are always allowed.
#OMNICONTEXT_ALLOWED_HOSTS=my-vault.example.com

# Optional: retention knobs (defaults shown).
# Raw clipboard items older than this many days are pruned daily.
#OMNICONTEXT_CLIPBOARD_MAX_AGE_DAYS=30
# At most this many raw clipboard items are kept (newest win).
#OMNICONTEXT_CLIPBOARD_MAX_COUNT=2000
# Browser-history entries older than this many days are pruned daily.
#OMNICONTEXT_HISTORY_MAX_AGE_DAYS=90
