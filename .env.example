# Bearer token for the HTTP API (POST /ingest, POST /search, GET /recent).
# Required if you expose port 4322 via a tunnel for ChatGPT Actions or phone
# ingestion. Generate one:  openssl rand -hex 32
OMNICONTEXT_API_KEY=change-me

# Optional: clipboard noise-control knobs (defaults shown).
# Raw clipboard items older than this many days are pruned daily.
#OMNICONTEXT_CLIPBOARD_MAX_AGE_DAYS=30
# At most this many raw clipboard items are kept (newest win).
#OMNICONTEXT_CLIPBOARD_MAX_COUNT=2000
