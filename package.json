{
  "name": "omnicontext",
  "version": "1.0.0",
  "description": "Local personal AI context database and MCP server",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "test": "tsc && node --test 'dist/**/*.test.js'",
    "install-daemon": "bash scripts/install-daemon.sh",
    "uninstall-daemon": "bash scripts/uninstall-daemon.sh",
    "vault:status": "node dist/vault.js status",
    "vault:purge": "node dist/vault.js purge"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@types/jsdom": "^28.0.3",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "jsdom": "^29.1.1",
    "react-tweet": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^5.3.3"
  }
}
